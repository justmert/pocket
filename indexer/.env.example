# Template for indexer/.env (which is gitignored). Copy it and adjust.
#
#   cp .env.example .env
#
# All values here are public testnet addresses, no secrets. The package.json
# scripts load .env via `node --env-file-if-exists=.env`.

RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Confidential token contract to ingest. Pocket has two on testnet; one ingest run
# covers one contract, so run ingest per contract into the same DB_PATH to serve both.
#   XLM  wrapper: CDMXZEFOM5DN2GSHQKNOOW242RJZGCEM5LOOAPGRQE35GGHB7ALDK2Y6
#   USDC wrapper: CBCCCG6THS4QHMHYNXEPDA4RFBJ7L2I2YHJJFV3G74PM2LAS6GBMBNZS
CONTRACT_ID=CDMXZEFOM5DN2GSHQKNOOW242RJZGCEM5LOOAPGRQE35GGHB7ALDK2Y6

# Must match the port in the extension's VITE_ARCHIVE_URL.
PORT=8787
DB_PATH=pocket-archive.db
ARCHIVE_ALLOWED_ORIGIN=*
