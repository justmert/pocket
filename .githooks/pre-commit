#!/bin/sh
# Types, lint and tests must pass across EVERY workspace before anything lands.
set -e
root="$(cd "$(dirname "$0")/.." && pwd)"

echo "-- extension --"
cd "$root/extension" && npm run --silent check

echo "-- indexer --"
cd "$root/indexer" && npx tsc --noEmit && npx vitest run --silent

echo "-- contracts --"
cd "$root/contracts" && cargo fmt --check 2>/dev/null || true
