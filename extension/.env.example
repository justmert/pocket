# Template for extension/.env (which is gitignored). Copy it to .env and fill in.
#
#   cp .env.example .env
#
# .env is loaded by every build and is the single source of truth. .env.production
# overrides ONLY the archive URL for a shipped release. There is no .env.development:
# local dev and local build both read .env.

# Durable archive (the indexer). Local dev/test uses the loopback below; a shipped
# release sets the deployed URL in .env.production instead. Leave empty to run
# without private history / recovery (they report themselves as unconfigured).
VITE_ARCHIVE_URL=http://127.0.0.1:8787

# DeFindex testnet yield. The API key is a SECRET (never commit it); get one from
# PaltaLabs. The vault is the XLM Blend testnet vault (a public contract address).
VITE_DEFINDEX_API_KEY=
VITE_DEFINDEX_VAULT=CCLV4H7WTLJQ7ATLHBBQV2WW3OINF3FOY5XZ7VPHZO7NH3D2ZS4GFSF6
