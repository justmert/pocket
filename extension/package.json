{
  "name": "pocket-extension",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run vendor && wxt",
    "build": "npm run vendor && wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,tsx,css}\" && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && eslint src && vitest run && vitest run --config vitest.suites.config.ts",
    "check:ci": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && eslint src && vitest run",
    "test:suites": "vitest run --config vitest.suites.config.ts",
    "test:e2e": "npm run vendor && wxt build && playwright test",
    "vendor": "node scripts/vendor-bb.mjs && node scripts/vendor-srs.mjs && node scripts/vendor-circuits.mjs",
    "vendor:icons": "node scripts/vendor-token-icons.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e:live": "POCKET_LIVE_E2E=1 playwright test --reporter=line",
    "test:pass": "npm run build && playwright test -c playwright.tests.config.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "^0.87.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@noir-lang/noir_js": "^1.0.0-beta.11",
    "@paper-design/shaders-react": "^0.0.78",
    "@scure/bip39": "2.2.0",
    "@stellar/js-xdr": "^4.0.0",
    "@stellar/stellar-sdk": "16.2.0",
    "@zkpassport/poseidon2": "^0.6.2",
    "buffer": "6.0.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.0",
    "playwright": "^1.62.1",
    "prettier": "3.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "0.21.2"
  }
}
