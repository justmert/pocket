{
  "name": "pocket-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run vendor && wxt",
    "build": "npm run vendor && wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,tsx,css}\" && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check": "tsc --noEmit && eslint src && vitest run",
    "test:e2e": "npm run vendor && wxt build && playwright test",
    "vendor": "node scripts/vendor-bb.mjs && node scripts/vendor-srs.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "^0.87.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@stellar/stellar-sdk": "16.2.0",
    "@zkpassport/poseidon2": "^0.6.2",
    "buffer": "6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.0",
    "playwright": "^1.62.1",
    "prettier": "3.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wxt": "0.21.2"
  }
}
